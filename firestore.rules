rules_version = '2';

// Prototype profile contract (docs/firebase.md): users/{uid} contains only
// uid (owner, immutable), displayName (nonblank, <=80), createdAt (immutable
// server timestamp), updatedAt (server timestamp), and schemaVersion (1).
// No email/password, membership, roles, media, or game data is client-writable.
// accounts/{uid}: server tombstone blocks stale tokens after deletion.
// pairing/{uid}: server-only status, invitationId, coupleId, updatedAt.
// invitations/{sha256(code)}: creator/claimant IDs and bounded names, status,
// timestamps, expiry and accepted coupleId. Exact reads by participants only.
// couples/{id}: server-only status, exactly two distinct memberUids and names.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null
        && (!exists(/databases/$(database)/documents/accounts/$(request.auth.uid))
          || get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.state == 'active');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged() {
      return request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return request.resource.data.uid == resource.data.uid;
    }

    function isValidUser(userId) {
      let data = request.resource.data;
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt', 'schemaVersion'])
        && data.keys().hasOnly(['uid', 'displayName', 'createdAt', 'updatedAt', 'schemaVersion'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.uid == userId
        && data.displayName is string
        && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.displayName.matches('.*[^\\s\\p{Z}].*')
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.updatedAt == request.time
        && data.schemaVersion is int && data.schemaVersion == 1;
    }

    match /users/{userId} {
      // Exact document reads only. No public or authenticated directory.
      allow get: if isOwner(userId);
      allow list, delete: if false;
      allow create: if isOwner(userId) && isValidUser(userId)
        && uidUnchanged() && request.resource.data.createdAt == request.time;
      allow update: if isOwner(userId) && isValidUser(userId)
        && uidNotModified()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'updatedAt']);
    }

    function isCoupleMember(coupleId) {
      return isAuthenticated() && validCoupleMembership(coupleId);
    }

    function validCoupleMembership(coupleId) {
      let couple = get(/databases/$(database)/documents/couples/$(coupleId)).data;
      return get(/databases/$(database)/documents/pairing/$(request.auth.uid)).data.coupleId == coupleId
        && couple.status == 'active'
        && couple.memberUids is list && couple.memberUids.size() == 2
        && couple.memberUids[0] is string && couple.memberUids[1] is string
        && couple.memberUids[0] != couple.memberUids[1]
        && request.auth.uid in couple.memberUids;
    }

    match /pairing/{userId} {
      allow get: if isOwner(userId);
      allow list, write: if false;
    }
    match /invitations/{invitationId} {
      allow get: if isAuthenticated()
        && (resource.data.creatorUid == request.auth.uid
          || resource.data.claimantUid == request.auth.uid);
      allow list, write: if false;
    }
    match /couples/{coupleId} {
      allow get: if isCoupleMember(coupleId);
      allow list, write: if false;
      match /content/{contentId} {
        allow get: if isCoupleMember(coupleId) && resource.data.deleted == false;
        allow list: if isCoupleMember(coupleId) && resource.data.deleted == false
          && request.query.limit != null && request.query.limit <= 20;
        allow write: if false;
      }
      match /matches/{matchId} {
        allow get: if isCoupleMember(coupleId);
        allow list: if isCoupleMember(coupleId)
          && request.query.limit != null && request.query.limit <= 20;
        allow write: if false;
        match /moves/{moveId} {
          allow get: if isCoupleMember(coupleId);
          allow list: if isCoupleMember(coupleId)
            && request.query.limit != null && request.query.limit <= 20;
          allow write: if false;
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
